enable
configure terminal

!================================
! Basic Device Configuration
!================================

hostname MLS-CORE-A

enable secret Qwe123!$

username admin secret Qwe123!$

line console 0
 logging synchronous
 login local

line vty 0 15
 login local

!================================
! VLAN Configuration
!================================

vlan 10
 name MANAGEMENT

vlan 20
 name USERS

vlan 30
 name SERVERS

vlan 40
 name GUEST

vlan 100
 name FINANCE

vlan 999
 name NATIVE

!================================
! Layer 3 Routing
!================================

ip routing

!================================
! Port-Channel To MLS-CORE-B
!================================

interface Port-channel1
 description PORTCHANNEL_TO_MLS-CORE-B
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,30,40,100,999

interface GigabitEthernet0/2
 description PO1_MEMBER
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active

interface GigabitEthernet0/3
 description PO1_MEMBER
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active

!================================
! Trunks To Access Switches
!================================

interface GigabitEthernet1/0
 description TRUNK_TO_ACC-A
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,100

interface GigabitEthernet2/0
 description TRUNK_TO_ACC-B
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,100

!================================
! Firewall Transit Interfaces
!================================

interface GigabitEthernet0/0
 description TO_FG-FW-A
 no switchport
 ip address 10.42.5.2 255.255.255.252

interface GigabitEthernet0/1
 description TO_FG-FW-B
 no switchport
 ip address 10.42.5.10 255.255.255.252

!================================
! VLAN Interfaces
!================================

interface vlan 10
 ip address 10.42.10.2 255.255.255.0
 standby 10 ip 10.42.10.1
 standby 10 priority 110
 standby 10 preempt
 no shut

interface vlan 20
 ip address 10.42.20.2 255.255.255.0
 standby 20 ip 10.42.20.1
 standby 20 priority 110
 standby 20 preempt
 no shut

interface vlan 30
 ip address 10.42.30.2 255.255.255.0
 standby 30 ip 10.42.30.1
 standby 30 priority 110
 standby 30 preempt
 no shut

interface vlan 40
 ip address 10.42.40.2 255.255.255.0
 standby 40 ip 10.42.40.1
 standby 40 priority 110
 standby 40 preempt
 no shut

interface vlan 100
 ip address 10.42.100.2 255.255.255.0
 standby 100 ip 10.42.100.1
 standby 100 priority 110
 standby 100 preempt
 no shut

!================================
! OSPF
!================================

router ospf 42

 network 10.42.5.0 0.0.0.3 area 0
 network 10.42.5.8 0.0.0.3 area 0

 network 10.42.10.0 0.0.0.255 area 0
 network 10.42.20.0 0.0.0.255 area 0
 network 10.42.30.0 0.0.0.255 area 0
 network 10.42.40.0 0.0.0.255 area 0
 network 10.42.100.0 0.0.0.255 area 0

!================================
! Save Configuration
!================================

end
write memory
