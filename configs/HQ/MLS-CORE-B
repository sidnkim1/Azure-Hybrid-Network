enable
configure terminal

!================================
! Basic Device Configuration
!================================

hostname MLS-CORE-B

enable secret Qwe123!$

username admin secret Qwe123!$

line console 0
 logging synchronous
 login local

line vty 0 15
 login local

!================================
! VLAN Configuration
!================================

vlan 10
 name MANAGEMENT

vlan 20
 name USERS

vlan 30
 name SERVERS

vlan 40
 name GUEST

vlan 100
 name FINANCE

vlan 999
 name NATIVE

!================================
! Layer 3 Routing
!================================

ip routing

!================================
! Port-Channel To MLS-CORE-A
!================================

interface Port-channel1
 description PORTCHANNEL_TO_MLS-CORE-A
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,30,40,100,999
 no shutdown

interface range GigabitEthernet0/2 - 3
 description PO1_MEMBER
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,30,40,100,999
 channel-group 1 mode active

!================================
! Trunks To Access Switches
!================================

interface GigabitEthernet1/0
 description TRUNK_TO_ACC-A
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,100

interface GigabitEthernet2/0
 description TRUNK_TO_ACC-B
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,40,100

!================================
! Firewall Transit Interfaces
!================================

interface GigabitEthernet0/0
 description TO_FG-FW-A
 no switchport
 ip address 10.42.5.6 255.255.255.252

interface GigabitEthernet0/1
 description TO_FG-FW-B
 no switchport
 ip address 10.42.5.14 255.255.255.252

!================================
! VLAN Interfaces
!================================

interface vlan 10
 ip address 10.42.10.3 255.255.255.0
 no shutdown
 standby 10 ip 10.42.10.1
 standby 10 priority 100
 standby 10 preempt

interface vlan 20
 ip address 10.42.20.3 255.255.255.0
 no shutdown
 standby 20 ip 10.42.20.1
 standby 20 priority 100
 standby 20 preempt

interface vlan 30
 ip address 10.42.30.3 255.255.255.0
 no shutdown
 standby 30 ip 10.42.30.1
 standby 30 priority 100
 standby 30 preempt

interface vlan 40
 ip address 10.42.40.3 255.255.255.0
 no shutdown
 standby 40 ip 10.42.40.1
 standby 40 priority 100
 standby 40 preempt

interface vlan 100
 ip address 10.42.100.3 255.255.255.0
 no shutdown
 standby 100 ip 10.42.100.1
 standby 100 priority 100
 standby 100 preempt

!================================
! OSPF
!================================

router ospf 42

 network 10.42.5.4 0.0.0.3 area 0
 network 10.42.5.12 0.0.0.3 area 0

 network 10.42.10.0 0.0.0.255 area 0
 network 10.42.20.0 0.0.0.255 area 0
 network 10.42.30.0 0.0.0.255 area 0
 network 10.42.40.0 0.0.0.255 area 0
 network 10.42.100.0 0.0.0.255 area 0

!================================
! Save Configuration
!================================

end
write memory
